objectTypes = {

#################################################
# ZYX 轻型坦克 pdxmesh 定义
# 所有 pdxmesh 使用 ZYX_ 前缀，避免与 Workshop mod / mod 91 的 geo_ 同名定义冲突
# 所有 file 路径指向 tanks/（复数），.mesh 和 .anim 文件由 Workshop mod 或 TEST mod 自身提供
#################################################

#============================================
# CV33 (light_tank_0) — geo_l3 系列
#============================================

	pdxmesh = {
		name = "ZYX_l3_mesh"
		file = "gfx/models/units/ZYX_models/geo_l3.mesh"

		animation = { id = "idle"	type = "geo_l3_idle_animation" }
		animation = { id = "move"	type = "geo_l3_move_animation" }
		animation = { id = "attack"	type = "geo_l3_attack_animation" }

		variant = { weight = 1.0 pdxmesh = "ZYX_l3_normal_mesh" }
		variant = { weight = 1.0 pdxmesh = "ZYX_l3_normal_mesh" }
		variant = { weight = 1.0 pdxmesh = "ZYX_l3_camo_mesh" }
	}

	pdxmesh = {
		name = "ZYX_l3_normal_mesh"
		file = "gfx/models/units/ZYX_models/geo_l3.mesh"

		animation = { id = "idle"	type = "geo_l3_idle_animation" }
		animation = { id = "move"	type = "geo_l3_move_animation" }
		animation = { id = "attack"	type = "geo_l3_attack_animation" }
	}

	pdxmesh = {
		name = "ZYX_l3_camo_mesh"
		file = "gfx/models/units/ZYX_models/geo_l3.mesh"

		animation = { id = "idle"	type = "geo_l3_idle_animation" }
		animation = { id = "move"	type = "geo_l3_move_animation" }
		animation = { id = "attack"	type = "geo_l3_attack_animation" }

		meshsettings = {
			name = "geo_l3"
			index = 0
			texture_diffuse = "geo_l3_camo_diffuse.dds"
			texture_normal = "geo_l3_normal.dds"
			texture_specular = "geo_l3_specular.dds"
			shader = "PdxMeshAdvanced"
		}
	}

#============================================
# T26 (light_tank_1) — geo_t26obr1933 / vickers6t 动画
#============================================

	pdxmesh = {
		name = "ZYX_t26obr1933_mesh"
		file = "gfx/models/units/ZYX_models/geo_t26obr1933.mesh"

		animation = { id = "idle"	type = "geo_vickers6t_idle_animation" }
		animation = { id = "move"	type = "geo_vickers6t_move_animation" }
		animation = { id = "attack"	type = "geo_vickers6t_attack_animation" }
	}

#============================================
# 94式 (light_tank_2) — geo_type94 系列
#============================================

	pdxmesh = {
		name = "ZYX_type94_mesh"
		file = "gfx/models/units/ZYX_models/geo_type94.mesh"

		animation = { id = "idle"	type = "geo_type94_idle_animation" }
		animation = { id = "move"	type = "geo_type94_move_animation" }
		animation = { id = "attack"	type = "geo_type94_attack_animation" }
	}

}
