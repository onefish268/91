	# 三种状态（采齐利娅 / 布里 / 梅莱斯）由 defined_text 按变量切
	containerWindowType = {
		name = "YSS_srgdtm_ui_window"
		position = { x = 0 y = 0 }
		size = { width = 500 height = 244 }
		iconType = {
			name = "srgdtm_figure"
			position = { x = 0 y = 0 }
		}
	}
}
