#text动态本地化的调用需要使用"[scripted_loc_name]"
#pdx_tooltip动态本地化需要绕弯子，不可以直接引用，而应当 pdx_tooltip = information information="[tips]"

guiTypes = {

# 右上角悬浮按钮容器
    containerWindowType = {
    	name = "Information_menu"         # 对应 scripted_gui 中的 window_name
    
    	# 对齐方式：右上角为定位基准
    	orientation = UPPER_RIGHT
    
    	# 容器尺寸：宽40像素，高40像素
    	size = { width = 35 height = 35 }
    
    	# 位置：距离右上角向左偏移50像素，向下偏移10像素
    	position = {
    	    x = -140
    	    y = 0
    	}
    
    	# 背景透明（不需要额外背景图）
    	background = {
    	    position = { x = 0 y = 0 }
    	    name = "Background"
    	    spriteType = "GFX_SA_empty"
    	}
    
    	# 点击容器时提升到最前
    	click_to_front = yes
    
    	# 可拖动
    	#moveable = yes
		
    	# 按钮子元素
    	buttonType = {
    	    name = "btn_add_pp"                    # 对应 scripted_gui 中的 effects 按钮名
        
    	    # 按钮位置（相对于容器左上角）
    	    position = { x = 0 y = 0 }
        
    	    spriteType = "GFX_SA_button"
        
    	    # 鼠标悬停提示文本（需要在 localisation 中定义）
    	    pdx_tooltip = menu_button_tip
        
    	    # 点击音效
    	    clicksound = click_default
        
    	    # 缩放比例
    	    scale = 1
    	}
	}

	containerWindowType = {
