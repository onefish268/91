@FACTION_TEXT_X = 55
@LOYALTY_TEXT_X = 240
@POPULARITY_TEXT_X = 380
@FACTION_ICONS_X = 10
@FACTION_NAMES_X = 55
@HEADERS_Y = 0
@BANNER_Y = 10                # 大图距离窗口顶部的Y偏移
@BANNER_HEIGHT = 120          # 顶部大图片高度
@BANNER_DESC_Y_OFFSET = 130   # 注释文本相对banner Y的偏移
@PANEL_CONTENT_START_Y = 240  # 原有派系内容整体从这个Y开始
guiTypes = {

	containerWindowType = {
		name = "ZSB_internal_factions_decision_ui_window"
		position = { x = 0 y = 0 }
		size = { width = 100% height= 1200 }
		clipping = no

		iconType = {
			name = "ZSB_faction_panel_banner"
			spriteType = "GFX_ZSB_faction_panel_banner" # 替换为你自己的sprite名称
			position = { x = 0 y = @BANNER_Y }
			size = { width = 100% height = @BANNER_HEIGHT }
		}

		instantTextBoxType = {
			name = "ZSB_faction_panel_banner_desc"
			position = { x = 0 y = @BANNER_DESC_Y_OFFSET }
			font = "hoi_18mbs"
			text = "BUL_faction_panel_banner_desc" # 在本地化填写图片注释文字
			format = center
			max_width = 100%
			max_height = 30
