##宣传部门
@POSTER_LEFT_X = 15
@POSTER_CENTER_X = 185
@POSTER_RIGHT_X = 365
@BACKGROUND_X = 6 #Should be 0 but the UI moves to the right once after activating GUI or taking a dec
@BACKGROUND_Y = -10
@POSTERS_Y = 2
@TEXT_LEFT_X = 15
@TEXT_CENTER_X = 170
@TEXT_RIGHT_X = 315
@TEXTS_Y = 215

guiTypes = {
	containerWindowType = {
		name = "YSS_publicity_campaigns_ui_window"
		position = { x = 0 y = 0 }
		size = { width = 100% height= 200 }
		#BACKGROUND
		iconType = {
			name = "YSS_xc_ui_background"
			spriteType = GFX_YSS_xuanchuan_icon
			position = { x= 5 y= -15 }
			scale = 1
		}
		iconType = {
			name ="propaganda_bg"
			spriteType = "GFX_propaganda_bg"
			position = { x=@BACKGROUND_X y=@BACKGROUND_Y }
		}
		#POSTER LEFT
		iconType = {
			name ="YSS_publicity_solt_A"
			position = { x=@POSTER_LEFT_X	 y=@POSTERS_Y }
			#pdx_tooltip = SOV_PROPAGANDA_CAMPAIGN_TT_LEFT
		}
		#POSTER CENTER
		iconType = {
			name ="YSS_publicity_solt_B"
			position = { x=@POSTER_CENTER_X	 y=@POSTERS_Y }
			#pdx_tooltip = SOV_PROPAGANDA_CAMPAIGN_TT_CENTER
		}
		#POSTER RIGHT
		iconType = {
			name ="YSS_publicity_solt_C"
			position = { x=@POSTER_RIGHT_X	 y=@POSTERS_Y }
			#pdx_tooltip = SOV_PROPAGANDA_CAMPAIGN_TT_RIGHT
		}
	}
}
